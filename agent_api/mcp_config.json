{
  "servers": [
    {
      "name": "python-executor",
      "transport": "stdio",
      "enabled": true,
      "auto_start": true,
      "command": "deno",
      "args": [
        "run",
        "-N",
        "-R=node_modules",
        "-W=node_modules",
        "--node-modules-dir=auto",
        "jsr:@pydantic/mcp-run-python",
        "stdio"
      ],
      "retry_attempts": 3,
      "retry_delay": 3,
      "health_check_interval": 30,
      "timeout": 10
    }
  ]
}
